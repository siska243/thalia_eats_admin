APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Quotation : à false, le montant facturé reste celui envoyé par le client
# et le serveur se contente de journaliser les écarts (canal « quotation »).
QUOTATION_AUTHORITATIVE=false

# Adresse appelee par FlexPay pour confirmer un paiement.
# Par defaut (valeur ci-dessous), retombe sur le domaine de production : ne
# derive PAS d'APP_URL, qui n'est pas maintenue comme l'origine publique
# de ce projet. A changer uniquement si l'API est reellement joignable sous
# un autre domaine.
FLEXPAY_CALLBACK_URL=https://app.thaliaeats.com/api/webhook-paiement-flexpay

# Origine publique annoncee par le serveur d'autorisation OAuth (assistants).
# Meme regle que ci-dessus : ne derive PAS d'APP_URL. C'est l'emetteur du
# document /.well-known/oauth-authorization-server et la base des adresses
# qu'il publie ; il doit correspondre au serveur d'autorisation annonce par le
# connecteur MCP. Doit etre en https, sinon le document n'est pas servi.
OAUTH_ORIGINE=https://app.thaliaeats.com

# Duree de vie par defaut d'un jeton, en minutes. Vide = jamais.
# Les jetons d'assistant portent leur propre expiration, independamment.
SANCTUM_EXPIRATION=

PRECOMMANDE_VALIDITE_HEURES=12
PRECOMMANDE_VISIBILITE_JOURS=30
