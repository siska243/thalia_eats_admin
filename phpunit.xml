<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        Aucune base n'est epinglee ici, et c'est voulu.

        La suite tourne sur la base nommee par .env.testing (voir
        .env.testing.example), poste par poste : epingler un nom unique ici
        ferait tourner deux sessions de travail sur la meme base et les ferait
        se tronquer l'une l'autre en plein run.

        Ce qui protege les donnees reelles n'est donc pas ce fichier mais le
        garde de Tests\CreatesApplication::createApplication(), qui refuse de
        demarrer sur une base dont le nom ne se termine pas par « _test ». Il
        s'execute avant setUpTraits(), donc avant que RefreshDatabase ou
        DatabaseTruncation n'aient touche quoi que ce soit : un poste mal
        configure s'arrete au lieu d'effacer.
    -->
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!--
            Le filet sur les actions qui echouent est ETEINT en test : la
            suite parle depuis une seule adresse et plusieurs classes
            enchainent des dizaines de refus attendus. LimiteDesEchecsTest le
            rallume explicitement, la protection reste donc prouvee.
        -->
        <env name="LIMITE_ECHECS_ACTIF" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
