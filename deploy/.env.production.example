# MODELE de l'environnement de production. Ce fichier ne contient AUCUN
# secret : c'est ce qui lui permet de voyager.
#
#   cp .env.production.example .env.production
#   nano .env.production
#
# Les 14 cles suivantes sont vides. Reportez leurs valeurs depuis votre
# gestionnaire de mots de passe, directement sur le serveur :
#
#   APP_KEY
#   DB_PASSWORD
#   REDIS_PASSWORD
#   MAIL_PASSWORD
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   GOOGLE_MAPS_API_KEY
#   FlEX_PAY_TOKEN
#   PUSHER_APP_ID
#   PUSHER_APP_KEY
#   PUSHER_APP_SECRET
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#   VITE_PUSHER_APP_KEY
#
# Elles ont ete detectees par regle, pas par liste : un nom evoquant un
# identifiant, ou une valeur ressemblant a un secret. Une liste ecrite a la
# main avait laisse passer FlEX_PAY_TOKEN — le jeton marchand FlexPay — a
# cause de sa casse inhabituelle.
#
# Une fois rempli, .env.production ne doit ni etre versionne, ni repartir vers
# une autre machine. docker-compose.yml le monte en lecture seule ; il n'entre
# jamais dans une couche de l'image.
#
# A verifier :
#   APP_URL      base des URL d'images et des liens de paiement signes.
#   DB_HOST      « db » : le nom du service dans docker-compose.yml, resolu
#                sur le reseau interne du projet. Pas 127.0.0.1, qui
#                designerait le conteneur applicatif lui-meme.
#   DB_USERNAME  et DB_PASSWORD doivent etre IDENTIQUES a ceux de .env :
#                c'est ce couple que le conteneur `db` cree au premier
#                demarrage. S'ils divergent, l'application ne se connecte pas.
#
# APP_KEY : en generer une NOUVELLE, propre a la production.
#
#   echo "base64:$(openssl rand -base64 32)"
#
# Verifie le 11 septembre 2026 : rien dans cette base n'est chiffre avec
# APP_KEY. Aucun cast « encrypted » sur les modeles, aucun appel a Crypt::,
# encrypt() ou decrypt(), aucun reglage Spatie chiffre. Cipher — qui produit
# les uid — a sa propre cle en dur et ne depend pas d'APP_KEY.
#
# Reprendre la cle du poste de developpement etait donc inutile, et moins sur :
# une cle de production n'a pas a vivre sur un portable.
#
# Ce qu'une nouvelle cle invalide : les sessions et cookies en cours, et les
# liens de paiement signes deja emis. Pas les jetons Sanctum de l'application
# mobile, qui sont haches en SHA-256 : personne n'est deconnecte.

APP_NAME="Thalia eats"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.thaliaeats.com

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=thalia_eats
DB_USERNAME=thalia
DB_PASSWORD=

# BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
#SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_SCHEME=null
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
FIREBASE_CREDENTIALS=storage/firebase_credentials.json
GOOGLE_MAPS_API_KEY=
FlEX_PAY_TOKEN=
FlEX_PAY_MERCHANT=thalia_eats

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
#PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=eu

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT="https://1c072c6e995c.ngrok-free.app/auth/google/callback"
REDIRECT_URI_MOBILE_REGISTER="exp://screens/register-screen"
REDIRECT_URI_MOBILE_LOGIN="exp://screens/login-screen"


PUSHER_HOST=api-eu.pusher.com/
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
SANCTUM_STATEFUL_DOMAINS=app.thaliaeats.com
SESSION_DRIVER=cookie


