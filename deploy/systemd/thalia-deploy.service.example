# MODELE — ce fichier n'est PAS celui que systemd lit.
#
# L'unite reellement utilisee vit dans /etc/systemd/system/, et c'est la
# qu'on la fabrique a partir d'ici (voir DEPLOIEMENT.md, section 10c).
#
# Pourquoi ce detour : User= doit nommer un utilisateur precis, donc ce
# fichier doit etre adapte a chaque machine. Tant qu'il etait suivi par git
# ET edite sur place, le serveur divergeait des le premier jour — et
# auto-deploy.sh, qui refuse de deployer quand un fichier suivi est modifie,
# bloquait alors TOUS les deploiements suivants. C'est arrive le
# 18 septembre 2026 : un « User=ubuntu » pose a l'installation avait gele la
# livraison continue sans que personne ne fasse le lien.
#
# Ne remettez donc jamais un fichier .service suivi a cet emplacement :
# .gitignore l'interdit desormais.

[Unit]
Description=Thalia Eats — déploiement depuis la branche suivie
Documentation=file:/srv/thalia-eats/code/deploy/DEPLOIEMENT.md
# Docker doit être prêt : le script construit et démarre des conteneurs.
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot

# Remplace a la copie par l'utilisateur proprietaire de /srv/thalia-eats,
# celui du groupe docker. Ne pas mettre root : le clone git utilise sa cle de
# deploiement, dans son ~/.ssh/config.
User=REMPLACER_PAR_VOTRE_UTILISATEUR

WorkingDirectory=/srv/thalia-eats/code
ExecStart=/srv/thalia-eats/code/deploy/auto-deploy.sh

# Le build peut durer plusieurs minutes au premier passage.
TimeoutStartSec=20min

# La sortie part dans journald : journalctl -u thalia-deploy -f
StandardOutput=journal
StandardError=journal
