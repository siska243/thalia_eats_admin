# MODELE des variables de Docker Compose. Ce fichier ne contient aucun secret :
# c'est ce qui lui permet de voyager.
#
#   cp .env.example .env
#   nano .env
#
# Compose lit le .env du dossier ou vit docker-compose.yml. Le placer ici
# plutot qu'a la racine du projet evite qu'il tente de parser le .env de
# Laravel, dont les lignes indentees le font echouer.

# ── Application ─────────────────────────────────────────────────────────────

# Port de boucle locale vers lequel Apache relaie.
#
# 8096 evite Connect RDC, deja deploye sur ce serveur : son
# docker-compose.prod.yml publie sur 127.0.0.1 aux ports 8090 (api), 8091
# (landing) et 8093 (admin) — son DEPLOY.md annonce 8080-8083, mais le compose
# fait foi. Verifier malgre tout :
#   ss -ltnp | grep -E '80(8|9)[0-9]'
APP_PORT=8096

# Dossier des donnees persistantes, HORS du dossier de code : un
# redeploiement ne doit jamais pouvoir les effacer.
DATA_DIR=/srv/thalia-eats/data

# Etiquette de l'image locale. Une date permet de revenir en arriere.
IMAGE_TAG=latest

# Migrations au demarrage du conteneur applicatif. Faux au premier
# deploiement : la base arrive par import et porte deja ses migrations.
THALIA_RUN_MIGRATIONS=false

# ── Base de donnees (conteneur `db`) ────────────────────────────────────────
#
# Ces deux mots de passe sont des SECRETS. Une fois ce fichier renseigne, il
# ne doit ni etre versionne, ni repartir vers une autre machine : le rsync
# l'exclut deja.
#
# Les generer en HEXADECIMAL, pas en base64 :
#
#   openssl rand -hex 24
#
# Ce fichier est lu par Docker Compose, et ses valeurs sont injectees dans
# docker-compose.yml — dont la sonde de la base, qui passe le mot de passe
# root a mysqladmin. Un « $ » y declencherait une interpolation, un « # » une
# fin de ligne, une apostrophe casserait la commande. L'hexadecimal n'a aucun
# de ces caracteres.
#
# Les memes valeurs de DB_DATABASE, DB_USERNAME et DB_PASSWORD doivent figurer
# dans .env.production, que lit Laravel. DB_ROOT_PASSWORD, lui, ne sert qu'a
# l'administration de la base et n'apparait pas cote application.

DB_DATABASE=thalia_eats
DB_USERNAME=thalia
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Dump importe AUTOMATIQUEMENT au tout premier demarrage, et uniquement
# celui-la : l'image MySQL n'execute /docker-entrypoint-initdb.d que si son
# volume de donnees est vide.
DUMP_FILE=/srv/thalia-eats/thalia_eats.sql.gz

# ── Connecteur MCP (conteneur `mcp`) ────────────────────────────────────────
#
# Le connecteur ne porte AUCUN secret : il ne stocke aucun jeton, chaque client
# envoie le sien a chaque requete. Rien de ce bloc n'est confidentiel.

# Port de boucle locale du connecteur. Apache relaie le sous-domaine MCP vers
# lui. 8097 suit 8096 et reste hors de la plage de Connect RDC (8090-8093) ;
# verifier malgre tout :
#   ss -ltnp | grep 8097
MCP_PORT=8097

# URL PUBLIQUE du connecteur, telle qu'un client la voit. OBLIGATOIRE.
#
# Elle part dans le document de metadonnees RFC 9728 et dans le defi 401 :
# une valeur fausse, et aucun client ne trouve ou s'authentifier.
MCP_URL_PUBLIQUE=https://mcp.thaliaeats.com

# API que le connecteur appelle. Par defaut la production publique : le
# connecteur est un client de l'API comme un autre, il ne court-circuite ni
# Apache, ni le TLS, ni Sanctum.
MCP_API_URL=https://app.thaliaeats.com

# Delai d'expiration des appels HTTP vers l'API, en secondes. Sans lui, une
# requete pendante bloquerait le connecteur.
MCP_DELAI_HTTP=15

# Liste blanche d'hotes (anti-DNS-rebinding), separes par des virgules.
# Vide = protection desactivee, ce qui est le bon reglage derriere Apache :
# l'en-tete Host y porte le domaine public, pas 127.0.0.1.
MCP_HOTES_AUTORISES=

# Etiquette de l'image du connecteur.
MCP_IMAGE_TAG=latest
